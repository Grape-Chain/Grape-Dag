# Sample environment for local development.
# Copy to `.env` (gitignored) and fill in real values; do not commit `.env`.

# REST API basic-auth credentials. If unset, the API does not configure
# basic-auth; callers must connect over a trusted network or set up a
# different authentication mechanism in front of the node.
LUNA_REST_API_USERNAME=luna
LUNA_REST_API_PASSWORD=changeme

# MongoDB connection used by the peer for ledger / stats persistence.
# Format: mongodb://<user>:<pass>@<host>:<port>/?<options>
LUNA_MONGODB_URI=mongodb://luna:changeme@localhost:47329/

# MongoDB used by tests in db/. If unset, tests assume an
# unauthenticated local MongoDB on port 47329.
LUNA_TEST_MONGODB_URI=mongodb://localhost:47329/

# PostgreSQL used by the postgres tests in db/postgres. The integration
# test is skipped if this is unset.
LUNA_TEST_POSTGRES_URI=postgres://luna:changeme@localhost:5432/lunadb
