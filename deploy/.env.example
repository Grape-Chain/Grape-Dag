# Sample environment for `docker compose -f deploy/docker-compose.yml up`.
# Copy to deploy/.env (gitignored) and replace the placeholder values.

# Image tag for the peer build. Override to release tags (e.g. v0.2.0)
# or short SHAs for pinned deployments.
LUNA_VERSION=dev

# Tag of ghcr.io/vg-grape/luna-smc to pull. Pin to a specific tag in
# production rather than `latest`. Leave the default and run
# `docker compose --build smc` to build the VM image from `../smc/` instead.
LUNA_SMC_TAG=latest

# REST API basic-auth credentials. The container fails to start if
# LUNA_REST_API_PASSWORD is empty.
LUNA_REST_API_USERNAME=luna
LUNA_REST_API_PASSWORD=changeme

# MongoDB credentials used by the peer and the mongo container itself.
# Both must agree.
MONGO_INITDB_ROOT_USERNAME=luna
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=lunadb
