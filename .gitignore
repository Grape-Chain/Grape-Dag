# Binaries
/bin/
/dist/
/build/
*.exe
*.test
*.out

# Web wallet build outputs (produced by `make wallet`):
# the signer binary and the loader copied out of the Go distribution
/web/wallet/wallet.wasm
/web/wallet/wallet.wasm.gz
/web/wallet/wasm_exec.js
# scratch output of scripts/wallet_e2e.mjs
/web/wallet/.e2e-signed.json

# Coverage
coverage.txt
coverage.html
*.cov

# Go workspace files (we use a single module)
go.work.sum

# Vendor (we don't vendor)
vendor/

# Env files — never commit secrets
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.iml
*.code-workspace

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Runtime artifacts written by a running peer
*.pid

# Logs
*.log
logs/

# Local config overrides
*.local.yml
*.local.yaml
config.local.*

# Backups written by a mutation-testing run. A mutation harness copies the file
# it is about to break so it can put it back; a run interrupted at the wrong
# moment leaves the copy behind, and committing one would put a deliberately
# broken source file in the tree next to the real one.
*.mutbak
*.go.bak

# Local development network: generated configs, wallets, ledger data and logs.
# Contains node private keys - never commit it.
.localnet/
