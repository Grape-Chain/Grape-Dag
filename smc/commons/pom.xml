  <modelVersion>4.0.0</modelVersion>

  <artifactId>commons</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.aplfintech.luna</groupId>
      <artifactId>luna1utils</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
